    "id": "K87-late-alarm",
    "kind": "python",
    "anchor": "tests/shell/test_prompt_deadline.py::test_direct_exec_timer_during_pipe_setup_exits_silently",
    "command": [
      "uv",
      "run",
      "--offline",
      "--no-project",
      "--with",
      "pytest",
      "--with",
      "pexpect",
      "--with",
      "pyte",
      "python",
      "-m",
      "pytest",
      "tests/shell/test_prompt_deadline.py::test_direct_exec_timer_during_pipe_setup_exits_silently",
      "-vv",
      "-p",
      "no:cacheprovider",
      "--basetemp",
      "target/m3a-mutation-shell"
    ],
    "patches": [
      {
        "file": "crates/bingsu/src/prompt_io.rs",
        "before": "    // Direct exec preserves ITIMER_REAL. Install ALRM before PIPE setup so\n    // an inherited timer expiring there is recorded, not fatal. This cannot\n    // protect the loader, argv collection, or any earlier entry window.\n    action.sa_sigaction = alarm_handler as *const () as usize;\n    action.sa_flags = 0; // In particular, no SA_RESTART.\n    // SAFETY: the handler has C ABI and process lifetime; mask is initialized.\n    if unsafe { libc::sigaction(libc::SIGALRM, &action, std::ptr::null_mut()) } != 0 {\n        return false;\n    }\n    action.sa_sigaction = libc::SIG_IGN;\n    // SAFETY: initialized action and a valid signal; no old action requested.\n    if unsafe { libc::sigaction(libc::SIGPIPE, &action, std::ptr::null_mut()) } != 0 {\n        return false;\n    }\n",
        "after": "    action.sa_sigaction = libc::SIG_IGN;\n    // SAFETY: initialized action and a valid signal; no old action requested.\n    if unsafe { libc::sigaction(libc::SIGPIPE, &action, std::ptr::null_mut()) } != 0 {\n        return false;\n    }\n    // Direct exec preserves ITIMER_REAL. Install ALRM before PIPE setup so\n    // an inherited timer expiring there is recorded, not fatal. This cannot\n    // protect the loader, argv collection, or any earlier entry window.\n    action.sa_sigaction = alarm_handler as *const () as usize;\n    action.sa_flags = 0; // In particular, no SA_RESTART.\n    // SAFETY: the handler has C ABI and process lifetime; mask is initialized.\n    if unsafe { libc::sigaction(libc::SIGALRM, &action, std::ptr::null_mut()) } != 0 {\n        return false;\n    }\n"
      }
    ],
    "timeout": 180,
    "reason": "이것을 실패시키는 것: K87-late-alarm",
    "build": [
      "cargo",
      "build",
      "-j",
      "2",
      "-p",
      "bingsu"
    ]
  },
