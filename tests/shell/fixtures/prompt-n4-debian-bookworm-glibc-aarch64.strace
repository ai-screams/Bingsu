 trailing empty field and accept 10 + separator.\n  [[ $rec == *$'\\x1f' ]] && return 1\n  _bingsu_split \"$rec\"\n  (( ${#_bingsu_t[@]} == 10 )) || return 1\n  [[ ${_bingsu_t[0]} == B1 && ${_bingsu_t[1]} == 8 ]] || return 1\n  _bingsu_status_ok \"${_bingsu_t[9]}\" || return 1\n  # Contract: on failure _bingsu_f is empty; it is set only after every check.\n  _bingsu_f=(\"${_bingsu_t[@]}\")\n}\n\n# nocasematch would make [[ == ]] case-insensitive (F-18): save, clear, restore.\n_bingsu_frame() {\n  local nm=0 r=0\n  _bingsu_f=()\n  if shopt -q nocasematch; then nm=1; shopt -u nocasematch; fi\n  _bingsu_frame_core \"$1\" || r=1\n  if (( nm )); then shopt -s nocasematch; fi\n  return \"$r\"\n}\n\n# Call only after _bingsu_status_ok passed (inputs are then lowercase, so\n# nocasematch cannot change any comparison below).\n_bingsu_classify() {\n  local st=$1 cls=${1%%:*} k\n  _bingsu_note=\n  if [[ $cls == ok ]]; then\n    _bingsu_disp=ok _bingsu_key=\n    return 0\n  fi\n  if [[ $cls == notice ]]; then _bingsu_disp=notice\n  elif [[ $cls == degraded ]]; then _bingsu_disp=degraded\n  elif [[ $cls == error ]]; then _bingsu_disp=error\n  else _bingsu_disp=degraded\n  fi\n  _bingsu_key=$st _bingsu_note=generic\n  for k in 'error:bad-args' 'error:internal' 'degraded:runtime-root' 'degraded:oversize' 'degraded:trust-unverified' 'degraded:trust-expired' 'degraded:trust-invalid' 'degraded:trust-mismatch' 'degraded:trust-clock' 'degraded:sandbox' 'error:config-last-good' 'error:config-default'; do\n    if [[ $st == \"$k\" ]]; then _bingsu_note=$k; break; fi\n  done\n  return 0\n}\n\n_bingsu_notice_due() {\n  [[ -n $2 && \"$2\" != \"$1\" ]]\n}\n\n# bingsu hooks for bash 5.1+ (spec section 5). init redefines every\n# function on each run; hook registration happens once (F-23).\n: \"${_bingsu_session:='84b0580f350c0b7e0a25bcf4171b50fd'}\"\n# Both may come from the environment. Only init's own shapes are kept: a\n# 32-digit lowercase hex session and a short decimal counter (the counter\n# goes through $(( )), which evaluates subscripts such as a[$(cmd)]).\n# nocasematch would let `case` accept uppercase hex (F-18): save, clear,\n# restore, as the reader does. The sets are spelled out, never ranges: with\n# globasciiranges off a range follows the locale's collation ([0-9] takes\n# U+0661 under fa_IR, [a-f] takes \303\251 under en_US).\n_bingsu_nm=0\nif shopt -q nocasematch; then _bingsu_nm=1; shopt -u nocasematch; fi\ncase $_bingsu_session in\n  *[^0123456789abcdef]*) _bingsu_session='84b0580f350c0b7e0a25bcf4171b50fd' ;;\nesac\nif (( _bingsu_nm )); then shopt -s nocasematch; fi\nunset _bingsu_nm\n(( ${#_bingsu_session} == 32 )) || _bingsu_session='84b0580f350c0b7e0a25bcf4171b50fd'\n: \"${_bingsu_seq:=0}\"\n_bingsu_rec=\n\n# Byte length of $1 into the caller's local _bingsu_n: ${#} counts\n# characters in a UTF-8 locale; the local LC_ALL ends with the function.\n# A readonly LC_ALL refuses the local one: then the length stays over the\n# cap, so $PWD is not passed (silently, the error goes to /dev/null).\n_bingsu_bytes() {\n  _bingsu_n=65537\n  local LC_ALL=C 2>/dev/null || return 0\n  _bingsu_n=${#1}\n}\n\n# Runs the pinned binary once; the raw record goes to _bingsu_rec. The group\n# redirect keeps bash's own \"ignored null byte\" warning off the terminal.\n# A call that a signal ended (status 128 or more) is not repeated until the\n# next command: bash numbers commands (\\#), and the number a dead call saw\n# is kept in _bingsu_dead_cn (same rule as hooks.zsh). The assignment runs\n# before ||, a context that also covers the substitution's subshell: a failed\n# call keeps its status but neither ends a `set -e` shell nor fires the\n# user's ERR trap.\n_bingsu_call() {\n  local _bingsu_cn='\\#'\n  _bingsu_cn=${_bingsu_cn@P}\n  if [[ ${_bingsu_dead_cn-} == \"$_bingsu_cn\" ]]; then\n    _bingsu_rec=\n    return 0\n  fi\n  case $_bingsu_seq in\n    ''|*[^0123456789]*|0?*|????????????????*) _bingsu_seq=0 ;;\n  esac\n  _bingsu_seq=$(( _bingsu_seq + 1 ))\n  # Over 64 KiB (bytes): passed empty (see hooks.zsh). ${PWD-}: set -u after\n  # unset PWD. _bingsu_bytes counts bytes under a local LC_ALL=C.\n  local _bingsu_pwd=${PWD-} _bingsu_n=0 _bingsu_st=0\n  # 2>/dev/null: restoring an LC_ALL naming a locale that is not installed\n  # makes bash warn when _bingsu_bytes returns.\n  _bingsu_bytes \"$_bingsu_pwd\" 2>/dev/null\n  (( _bingsu_n <= 65536 )) || _bingsu_pwd=\n  local _bingsu_log=off _bingsu_host=${HOSTNAME-} _bingsu_venv=${VIRTUAL_ENV-} _bingsu_ssh=0\n  local _bingsu_log_nm=0\n  if shopt -q nocasematch; then _bingsu_log_nm=1; shopt -u nocasematch; fi\n  case ${BINGSU_LOG-} in error|info|debug) _bingsu_log=$BINGSU_LOG ;; esac\n  if (( _bingsu_log_nm )); then shopt -s nocasematch; fi\n  _bingsu_bytes \"$_bingsu_host\" 2>/dev/null\n  (( _bingsu_n <= 65536 )) || _bingsu_host=\n  _bingsu_bytes \"$_bingsu_venv\" 2>/dev/null\n  (( _bingsu_n <= 65536 )) || _bingsu_venv=\n  [[ -n ${SSH_CONNECTION-} || -n ${SSH_TTY-} ]] && _bingsu_ssh=1\n  { _bingsu_rec=$('/home/USER/pt/CASE/bin/bingsu' prompt --ctx 1 --record 'B1' \"$@\" --shell bash --pwd \"$_bingsu_pwd\" --colorterm \"${COLORTERM-}\" \"--log-level=$_bingsu_log\" --host \"$_bingsu_host\" --venv \"$_bingsu_venv\" \"--ssh=$_bingsu_ssh\" --session \"$_bingsu_session\" --seq \"$_bingsu_seq\" '--runtime-root=42:6030942:/home/USER/pt/CASE/run-t/bingsu' '--runtime-groups=1' '--config-root=/home/USER/pt/CASE/cfg-t/bingsu' '--config-root-written=/home/USER/pt/CASE/cfg-t/bingsu' '--state-root=/home/USER/pt/CASE/state-t/bingsu' '--log-root=/home/USER/pt/CASE/state-t/bingsu/log' '--home=/home/USER'; _bingsu_r=$?; printf .; exit $_bingsu_r) || _bingsu_st=$?; } 2>/dev/null\n  (( _bingsu_st < 128 )) || _bingsu_dead_cn=$_bingsu_cn\n  _bingsu_rec=${_bingsu_rec%.}\n}\n\n# Hook state is reset on every init, never inherited: an environment value\n# for _bingsu_t0 or _bingsu_t1 would make the first duration wrong, and\n# either one goes through $(( )) (spec section 5).\n_bingsu_s=0 _bingsu_t1= _bingsu_ps1= _bingsu_dead_cn=\n_bingsu_p=()\n# _bingsu_t0 is a one-element array: PS0 assigns it inside $(( )), and under\n# `set -a` that assignment marks it for export before any hook can undo it.\n# bash never puts an array in the environment. Element 0 is set (empty), as\n# an unset one", 8192) = 8192
