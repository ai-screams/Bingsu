ingsu_seq=$(( _bingsu_seq + 1 ))\n  # Over 64 KiB (bytes): passed empty (see hooks.zsh). ${PWD-}: set -u after\n  # unset PWD. _bingsu_bytes counts bytes under a local LC_ALL=C.\n  local _bingsu_pwd=${PWD-} _bingsu_n=0 _bingsu_st=0\n  # 2>/dev/null: restoring an LC_ALL naming a locale that is not installed\n  # makes bash warn when _bingsu_bytes returns.\n  _bingsu_bytes \"$_bingsu_pwd\" 2>/dev/null\n  (( _bingsu_n <= 65536 )) || _bingsu_pwd=\n  local _bingsu_log=off _bingsu_host=${HOSTNAME-} _bingsu_venv=${VIRTUAL_ENV-} _bingsu_ssh=0 _bingsu_colorfgbg=${COLORFGBG-}\n  local _bingsu_log_nm=0\n  if shopt -q nocasematch; then _bingsu_log_nm=1; shopt -u nocasematch; fi\n  case ${BINGSU_LOG-} in error|info|debug) _bingsu_log=$BINGSU_LOG ;; esac\n  if (( _bingsu_log_nm )); then shopt -s nocasematch; fi\n  _bingsu_bytes \"$_bingsu_host\" 2>/dev/null\n  (( _bingsu_n <= 65536 )) || _bingsu_host=\n  _bingsu_bytes \"$_bingsu_venv\" 2>/dev/null\n  (( _bingsu_n <= 65536 )) || _bingsu_venv=\n  _bingsu_bytes \"$_bingsu_colorfgbg\" 2>/dev/null\n  (( _bingsu_n <= 65536 )) || _bingsu_colorfgbg=\n  [[ -n ${SSH_CONNECTION-} || -n ${SSH_TTY-} ]] && _bingsu_ssh=1\n  { _bingsu_rec=$('/home/USER/pt/CASE_BUILD_IDENTITY_TRACE_0000000/bin/bingsu' prompt --ctx 1 --record 'B1' \"$@\" --shell bash --pwd \"$_bingsu_pwd\" --colorterm \"${COLORTERM-}\" --colorfgbg \"$_bingsu_colorfgbg\" \"--log-level=$_bingsu_log\" --host \"$_bingsu_host\" --venv \"$_bingsu_venv\" \"--ssh=$_bingsu_ssh\" --session \"$_bingsu_session\" --seq \"$_bingsu_seq\" '--runtime-root=42:5796437:/home/USER/pt/CASE_BUILD_IDENTITY_TRACE_0000000/run-t/bingsu' '--runtime-groups=1' '--config-root=/home/USER/pt/CASE_BUILD_IDENTITY_TRACE_0000000/cfg-t/bingsu' '--config-root-written=/home/USER/pt/CASE_BUILD_IDENTITY_TRACE_0000000/cfg-t/bingsu' '--state-root=/home/USER/pt/CASE_BUILD_IDENTITY_TRACE_0000000/state-t/bingsu' '--log-root=/home/USER/pt/CASE_BUILD_IDENTITY_TRACE_0000000/state-t/bingsu/log' '--home=/home/USER'; _bingsu_r=$?; p